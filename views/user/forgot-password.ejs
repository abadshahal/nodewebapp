<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Forgot Password</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --navy:       #060d1a;
  --navy-mid:   #0b1527;
  --navy-card:  #0f1c35;
  --border:     #1e2d4a;
  --radius:     14px;
  --white:      #e8edf8;
  --muted:      #6b7fa3;
  --blue-glow:  #3b82f6;
  --blue-accent:#2563eb;
  --blue-deep:  #1a4fd8;
  --error:      #ef4444;
  --green:      #22c55e;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
  background: var(--navy);
  color: var(--white);
  min-height: 100vh;
  display: flex; align-items: center; justify-content: center;
  padding: 24px;
  position: relative;
}

body::before {
  content: '';
  position: fixed; inset: 0;
  background:
    radial-gradient(ellipse 60% 50% at 20% 30%, rgba(37,99,235,0.08) 0%, transparent 70%),
    radial-gradient(ellipse 50% 40% at 80% 70%, rgba(16,185,129,0.05) 0%, transparent 70%);
  pointer-events: none;
}

.lp-card {
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  width: 100%; max-width: 420px;
  overflow: hidden; position: relative;
  animation: slideUp 0.45s cubic-bezier(0.22,1,0.36,1) both;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}

.lp-card::before {
  content: '';
  position: absolute; top: 0; left: 10%; right: 10%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(59,130,246,0.5), transparent);
}

.lp-head {
  padding: 28px 32px 22px;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(135deg, #0d1b38, #0b1527);
}

.lp-icon {
  width: 44px; height: 44px;
  background: rgba(37,99,235,0.12);
  border: 1px solid rgba(37,99,235,0.25);
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 14px;
}

.lp-head h1 { font-size: 19px; font-weight: 700; letter-spacing: .03em; margin-bottom: 5px; }
.lp-head p  { font-size: 13px; color: var(--muted); line-height: 1.6; }

.lp-body { padding: 28px 32px 32px; }

/* alerts */
.lp-alert {
  padding: 10px 14px; border-radius: 8px;
  font-size: 13px; margin-bottom: 18px; display: none;
}
.lp-alert.show { display: block; }
.lp-alert.error   { background: rgba(239,68,68,0.12);  border: 1px solid rgba(239,68,68,0.3);  color: #fca5a5; }
.lp-alert.success { background: rgba(34,197,94,0.12);  border: 1px solid rgba(34,197,94,0.3);  color: #86efac; }

/* field */
.lp-field { margin-bottom: 20px; }
.lp-field label {
  display: block; font-size: 12px; font-weight: 600;
  letter-spacing: .06em; text-transform: uppercase;
  color: var(--muted); margin-bottom: 8px;
}
.lp-field input {
  width: 100%; padding: 12px 14px;
  background: var(--navy-mid); border: 1px solid var(--border);
  border-radius: 9px; color: var(--white);
  font-family: inherit; font-size: 14px; outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.lp-field input:focus {
  border-color: rgba(37,99,235,0.55);
  box-shadow: 0 0 0 3px rgba(37,99,235,0.10);
}
.lp-field input.err    { border-color: rgba(239,68,68,0.5); }
.lp-field input[readonly] { opacity: .65; cursor: not-allowed; }

.lp-error { font-size: 12px; color: var(--error); margin-top: 5px; min-height: 16px; display: block; }

/* button */
.lp-btn {
  width: 100%; padding: 13px;
  background: var(--blue-accent); color: #fff;
  border: none; border-radius: 9px;
  font-family: inherit; font-size: 14px; font-weight: 700;
  letter-spacing: .05em; cursor: pointer;
  position: relative; overflow: hidden;
  transition: background .2s, transform .15s;
}
.lp-btn::after { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.08), transparent); }
.lp-btn:hover:not(:disabled)  { background: var(--blue-deep); transform: translateY(-1px); }
.lp-btn:active:not(:disabled) { transform: translateY(0); }
.lp-btn:disabled { opacity: .45; cursor: not-allowed; transform: none; }

/* back link */
.lp-back {
  display: flex; align-items: center; justify-content: center;
  gap: 6px; margin-top: 18px;
  font-size: 13px; color: var(--muted);
  text-decoration: none; transition: color .2s;
}
.lp-back:hover { color: var(--blue-glow); }

@media(max-width:480px){ .lp-head, .lp-body { padding-left: 20px; padding-right: 20px; } }
</style>
</head>
<body>

<div class="lp-card">

  <div class="lp-head">
    <div class="lp-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>
    <h1>Forgot Password</h1>
    <p>Enter your registered email and we'll send you a verification code.</p>
  </div>

  <div class="lp-body">

    <div class="lp-alert error   <%= locals.error   ? 'show' : '' %>"><%= locals.error   || '' %></div>
    <div class="lp-alert success <%= locals.success ? 'show' : '' %>"><%= locals.success || '' %></div>

    <div class="lp-field">
      <label for="fpEmail">Email address</label>
      <input
        type="email" id="fpEmail" name="email"
        placeholder="you@example.com" autocomplete="email"
        value="<%= locals.email || '' %>"
        <%= locals.email ? 'readonly' : '' %>
      />
      <span class="lp-error" id="fpEmailErr"></span>
    </div>

    <button class="lp-btn" id="fpBtn" type="button">Send OTP</button>

    <a href="/profile" class="lp-back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
      Back to Profile
    </a>

  </div>
</div>

<script>
const emailEl  = document.getElementById('fpEmail');
const emailErr = document.getElementById('fpEmailErr');
const fpBtn    = document.getElementById('fpBtn');
const emailPattern = /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i;

function validate() {
  emailErr.textContent = '';
  emailEl.classList.remove('err');

  if (!emailEl.value.trim()) {
    emailErr.textContent = 'Email is required';
    emailEl.classList.add('err');
    return false;
  }
  if (!emailPattern.test(emailEl.value.trim())) {
    emailErr.textContent = 'Enter a valid email';
    emailEl.classList.add('err');
    return false;
  }
  return true;
}

fpBtn.addEventListener('click', async () => {
  if (!validate()) return;

  fpBtn.textContent = 'Sending…';
  fpBtn.disabled = true;

  try {
    const res  = await fetch('/forgot-password', {
      method : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body   : JSON.stringify({ email: emailEl.value.trim() })
    });

    const data = await res.json();

    if (data.success) {
      window.location.href = data.redirectUrl;
    } else {
      document.querySelector('.lp-alert.error').textContent = data.message || 'Something went wrong.';
      document.querySelector('.lp-alert.error').classList.add('show');
      fpBtn.textContent = 'Send OTP';
      fpBtn.disabled = false;
    }

  } catch {
    document.querySelector('.lp-alert.error').textContent = 'Could not reach server. Please try again.';
    document.querySelector('.lp-alert.error').classList.add('show');
    fpBtn.textContent = 'Send OTP';
    fpBtn.disabled = false;
  }
});

emailEl.addEventListener('keydown', e => { if (e.key === 'Enter') fpBtn.click(); });
</script>

</body>
</html>
