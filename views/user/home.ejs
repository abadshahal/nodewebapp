    <div class="mobile-actions">
  <% if (user) { %>
    <a href="/wishlist" class="btn-ghost">♡ Wishlist</a>
    <a href="/cart" class="btn-ghost">🛒 Cart</a>
    <a href="/profile" class="btn-ghost">Account</a>
