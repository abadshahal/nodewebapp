<%- include("../partials/user/header") %>



<style>
.cp-page {
  min-height: 100vh;
  background: var(--navy);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 24px;
}
.cp-card {
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  width: 100%;
  max-width: 460px;
  overflow: hidden;
  position: relative;
}
.cp-card::before {
  content: '';
  position: absolute;
  top: 0; left: 10%; right: 10%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(59,130,246,0.5), transparent);
}
.cp-head {
  padding: 28px 32px 22px;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(135deg, #0d1b38, #0b1527);
}
.cp-icon {
  width: 44px; height: 44px;
  background: rgba(37,99,235,0.12);
  border: 1px solid rgba(37,99,235,0.25);
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 14px;
}
.cp-head h1 { font-size: 19px; font-weight: 700; letter-spacing: .03em; margin-bottom: 5px; }
.cp-head p  { font-size: 13px; color: var(--muted); }
.cp-body { padding: 28px 32px 32px; }
.cp-field { margin-bottom: 16px; }
.cp-field label {
  display: block;
  font-size: 12px; font-weight: 600;
  letter-spacing: .06em; text-transform: uppercase;
  color: var(--muted); margin-bottom: 8px;
}
.cp-input-wrap { position: relative; display: flex; align-items: center; }
.cp-input-wrap input {
  width: 100%;
  padding: 12px 44px 12px 14px;
  background: var(--navy-mid);
  border: 1px solid var(--border);
  border-radius: 9px;
  color: var(--white);
  font-family: inherit; font-size: 14px; outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.cp-input-wrap input:focus {
  border-color: rgba(37,99,235,0.55);
  box-shadow: 0 0 0 3px rgba(37,99,235,0.10);
}
.cp-eye {
  position: absolute; right: 12px;
  background: none; border: none; cursor: pointer;
  color: var(--muted); padding: 2px;
  display: flex; align-items: center;
  transition: color .2s;
}
.cp-eye:hover { color: var(--white); }
.cp-hint { font-size: 12px; margin-top: 6px; min-height: 16px; }
.cp-hint.match   { color: #10b981; }
.cp-hint.nomatch { color: #ef4444; }
.cp-btn {
  width: 100%; margin-top: 8px; padding: 13px;
  background: var(--blue-accent); color: #fff;
  border: none; border-radius: 9px;
  font-family: inherit; font-size: 14px; font-weight: 700;
  letter-spacing: .05em; cursor: pointer;
  transition: background .2s, transform .15s;
}
.cp-btn:hover:not(:disabled) { background: #1a4fd8; transform: translateY(-1px); }
.cp-btn:disabled { opacity: .45; cursor: not-allowed; }
.cp-back {
  display: flex; align-items: center; justify-content: center;
  gap: 6px; margin-top: 18px;
  font-size: 13px; color: var(--muted);
  text-decoration: none; transition: color .2s;
}
.cp-back:hover { color: var(--white); }
</style>

<div class="cp-page">
  <div class="cp-card">
    <div class="cp-head">
      <div class="cp-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <h1>Reset password</h1>
      <p>Update password for <strong style="color:var(--white)"><%=email %></strong></p>
    </div>

    <div class="cp-body">

      <!-- <div class="cp-field">
        <label>Current Password</label>
        <div class="cp-input-wrap">
          <input type="password" id="cpCurrent" placeholder="Enter current password" />
          <button class="cp-eye" type="button" data-target="cpCurrent">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div> -->

      <div class="cp-field">
        <label>New Password</label>
        <div class="cp-input-wrap">
          <input type="password" id="cpNew" placeholder="Enter new password" />
          <button class="cp-eye" type="button" data-target="cpNew">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <div class="cp-field">
        <label>Confirm New Password</label>
        <div class="cp-input-wrap">
          <input type="password" id="cpConfirm" placeholder="Confirm new password" />
          <button class="cp-eye" type="button" data-target="cpConfirm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <div class="cp-hint" id="cpMatchHint"></div>
      </div>

      <button class="cp-btn" id="cpBtn" disabled>Update Password</button>

      <a href="/profile" class="cp-back">Back to profile
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        Back to Profile
      </a>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

const cpNew       = document.getElementById('cpNew');
const cpConfirm   = document.getElementById('cpConfirm');
const cpBtn       = document.getElementById('cpBtn');
const cpMatchHint = document.getElementById('cpMatchHint');

document.querySelectorAll('.cp-eye').forEach(btn => {
  btn.addEventListener('click', () => {
    const inp = document.getElementById(btn.dataset.target);
    inp.type = inp.type === 'password' ? 'text' : 'password';
  });
});

function validate() {
 
  const nw  = cpNew.value.trim();
  const cfm = cpConfirm.value.trim();

  if (cfm) {
    if (nw === cfm) {
      cpMatchHint.textContent = '✓ Passwords match';
      cpMatchHint.className = 'cp-hint match';
    } else {
      cpMatchHint.textContent = '✗ Passwords do not match';
      cpMatchHint.className = 'cp-hint nomatch';
    }
  } else {
    cpMatchHint.textContent = '';
  }

  cpBtn.disabled = !(nw.length >= 6 && nw === cfm);
}

[ cpNew, cpConfirm].forEach(el => el.addEventListener('input', validate));

cpBtn.addEventListener('click', async () => {
  cpBtn.textContent = 'Updating…';
  cpBtn.disabled = true;

  try {
    const res  = await fetch('/reset-password', {
      method : 'POST',
      headers: { 'Content-Type': 'application/json' },
     body: JSON.stringify({
      email: "<%= email %>",
    newPassword: cpNew.value.trim()
})
    });
    const data = await res.json();

    if (data.success) {
      Swal.fire({
        icon: 'success', title: 'Password Updated!',
        text: data.message, timer: 1600,
        showConfirmButton: false,
        background: '#111d3c', color: '#e8eaf0'
      }).then(() => window.location.href = '/signIn');
    } else {
      Swal.fire({
        icon: 'error', title: 'Failed',
        text: data.message,
        background: '#111d3c', color: '#e8eaf0',
        confirmButtonColor: '#2563eb'
      });
      cpBtn.textContent = 'Update Password';
      cpBtn.disabled = false;
    }
  } catch {
    Swal.fire({
      icon: 'error', title: 'Network Error',
      background: '#111d3c', color: '#e8eaf0'
    });
    cpBtn.textContent = 'Update Password';
    cpBtn.disabled = false;
  }
});
</script>

<%- include("../partials/user/footer") %>