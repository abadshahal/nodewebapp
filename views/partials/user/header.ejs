
     <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Velorian – Crafted for Those Who Value Every Moment</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
/* =============================================
   VELORIAN — LUXURY WATCH STORE STYLESHEET
   ============================================= */

/* ---------- CSS VARIABLES ---------- */
:root {
  --navy:        #0a0f1e;
  --navy-mid:    #0d1530;
  --navy-card:   #111d3c;
  --navy-hover:  #162040;
  --blue-accent: #2563eb;
  --blue-glow:   #3b82f6;
  --gold:        #c8a84b;
  --gold-light:  #e8c96e;
  --white:       #ffffff;
  --off-white:   #e8eaf0;
  --muted:       #8892a4;
  --red:         #e53e3e;
  --orange:      #f97316;
  --border:      rgba(37, 99, 235, 0.18);
  --card-shadow: 0 8px 32px rgba(0,0,0,0.45);

  --font-display: 'Cinzel', serif;
  --font-body:    'Raleway', sans-serif;

  --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --radius:     12px;
}

/* ---------- RESET & BASE ---------- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  background-color: var(--navy);
  color: var(--off-white);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }
ul { list-style: none; }
img { display: block; max-width: 100%; }
button { cursor: pointer; border: none; background: none; font-family: inherit; }
address { font-style: normal; }

/* ---------- SCROLLBAR ---------- */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--navy-mid); }
::-webkit-scrollbar-thumb { background: var(--blue-accent); border-radius: 3px; }

/* =============================================
   BUTTONS
   ============================================= */
.btn-primary {
  display: inline-block;
  background: var(--blue-accent);
  color: var(--white);
  padding: 9px 20px;
  border-radius: 6px;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.03em;
  transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
  white-space: nowrap;
}
.btn-primary:hover {
  background: var(--blue-glow);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(37,99,235,0.4);
}

.btn-ghost {
  display: inline-block;
  background: transparent;
  color: var(--off-white);
  padding: 9px 20px;
  border-radius: 6px;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  border: 1px solid var(--border);
  transition: border-color var(--transition), color var(--transition);
  white-space: nowrap;
}
.btn-ghost:hover { border-color: var(--blue-glow); color: var(--blue-glow); }

/* =============================================
   ANNOUNCEMENT BAR
   ============================================= */
.announcement-bar {
  background: var(--navy-mid);
  text-align: center;
  padding: 8px 16px;
  font-size: 13px;
  font-family: var(--font-body);
  color: var(--off-white);
  border-bottom: 1px solid var(--border);
  letter-spacing: 0.02em;
}
.announcement-bar strong { color: var(--gold); }

/* =============================================
   NAVBAR
   ============================================= */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(10, 15, 30, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 0 32px;
  display: flex;
  align-items: center;
  gap: 24px;
  height: 64px;
  transition: background var(--transition);
}
.navbar.scrolled { background: rgba(10, 15, 30, 0.99); }

.nav-left { display: flex; align-items: center; gap: 16px; }

.logo {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--white);
  transition: color var(--transition);
}
.logo:hover { color: var(--gold); }

.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  padding: 4px;
}
.hamburger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--off-white);
  border-radius: 2px;
  transition: var(--transition);
}
.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
  flex: 1;
}
.nav-links a {
  font-size: 14px;
  font-weight: 500;
  color: var(--muted);
  letter-spacing: 0.03em;
  transition: color var(--transition);
  position: relative;
}
.nav-links a::after {
  content: '';
  position: absolute;
  bottom: -4px; left: 0;
  width: 0; height: 2px;
  background: var(--blue-accent);
  transition: width var(--transition);
  border-radius: 2px;
}
.nav-links a:hover,
.nav-links a.active { color: var(--white); }
.nav-links a:hover::after,
.nav-links a.active::after { width: 100%; }

.nav-right {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-left: auto;
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  transition: border-color var(--transition);
}
.search-bar:focus-within { border-color: var(--blue-accent); }

.search-bar input {
  background: transparent;
  border: none;
  outline: none;
  padding: 8px 12px;
  font-size: 13px;
  font-family: var(--font-body);
  color: var(--off-white);
  width: 220px;
}
.search-bar input::placeholder { color: var(--muted); }

.search-bar button {
  padding: 8px 12px;
  color: var(--muted);
  transition: color var(--transition);
}
.search-bar button:hover { color: var(--blue-glow); }

.nav-actions { display: flex; align-items: center; gap: 10px; }

/* MOBILE MENU */
.mobile-menu {
  position: fixed;
  top: 0; right: -100%;
  width: min(300px, 80vw);
  height: 100vh;
  background: var(--navy-mid);
  border-left: 1px solid var(--border);
  z-index: 200;
  padding: 80px 32px 32px;
  display: flex;
  flex-direction: column;
  gap: 40px;
  transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
.mobile-menu.open { right: 0; }
.mobile-menu ul { display: flex; flex-direction: column; gap: 20px; }
.mobile-menu a {
  font-size: 16px;
  font-weight: 500;
  color: var(--off-white);
  transition: color var(--transition);
}
.mobile-menu a:hover { color: var(--blue-glow); }
.mobile-actions { display: flex; flex-direction: column; gap: 12px; }
.mobile-actions .btn-ghost,
.mobile-actions .btn-primary { text-align: center; }

/* =============================================
   HERO SECTION
   ============================================= */
.hero {
  position: relative;
  min-height: 480px;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 60%, #0e1a3a 100%);
}

.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: 
    radial-gradient(ellipse 60% 70% at 70% 50%, rgba(37,99,235,0.10) 0%, transparent 70%),
    radial-gradient(ellipse 40% 40% at 20% 80%, rgba(200,168,75,0.06) 0%, transparent 60%);
  pointer-events: none;
}

.hero-slides { width: 100%; position: relative; }

.hero-slide {
  display: none;
  align-items: center;
  justify-content: space-between;
  padding: 80px 80px 80px 60px;
  gap: 40px;
  animation: fadeSlide 0.6s ease;
}
.hero-slide.active { display: flex; }

@keyframes fadeSlide {
  from { opacity: 0; transform: translateX(30px); }
  to   { opacity: 1; transform: translateX(0); }
}

.hero-content { max-width: 520px; }

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(28px, 4vw, 52px);
  font-weight: 700;
  color: var(--white);
  line-height: 1.18;
  letter-spacing: 0.02em;
  margin-bottom: 32px;
  text-transform: uppercase;
}

.hero-cta { font-size: 14px; padding: 12px 32px; }

.hero-image { flex-shrink: 0; }

/* Animated watch orb */
.watch-orb {
  width: clamp(180px, 22vw, 300px);
  height: clamp(180px, 22vw, 300px);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.orb-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2px solid rgba(37, 99, 235, 0.4);
  animation: spin 12s linear infinite;
}
.orb-ring::before {
  content: '';
  position: absolute;
  top: -4px; left: 50%;
  width: 8px; height: 8px;
  background: var(--blue-accent);
  border-radius: 50%;
  transform: translateX(-50%);
  box-shadow: 0 0 12px var(--blue-glow);
}

.watch-orb.style2 .orb-ring { border-color: rgba(200, 168, 75, 0.4); animation-direction: reverse; }
.watch-orb.style2 .orb-ring::before { background: var(--gold); box-shadow: 0 0 12px var(--gold-light); }
.watch-orb.style3 .orb-ring { border-color: rgba(255,255,255,0.2); }
.watch-orb.style3 .orb-ring::before { background: var(--white); box-shadow: 0 0 12px rgba(255,255,255,0.5); }

@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.orb-inner {
  width: 70%;
  height: 70%;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #1a2a5e, var(--navy-mid));
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: clamp(48px, 6vw, 80px);
  box-shadow: 0 0 60px rgba(37,99,235,0.25), inset 0 0 30px rgba(0,0,0,0.5);
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-12px); }
}

/* Hero Arrows */
.hero-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(13, 21, 48, 0.7);
  border: 1px solid var(--border);
  color: var(--off-white);
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--transition), border-color var(--transition);
  backdrop-filter: blur(8px);
}
.hero-arrow:hover { background: var(--blue-accent); border-color: var(--blue-accent); }
.hero-arrow.left  { left: 20px; }
.hero-arrow.right { right: 20px; }

/* Hero Dots */
.hero-dots {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
}
.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  cursor: pointer;
  transition: background var(--transition), transform var(--transition);
}
.dot.active { background: var(--blue-accent); transform: scale(1.3); }

/* =============================================
   PRODUCT SECTIONS
   ============================================= */
.product-section {
  padding: 72px 60px;
}

.section-title {
  font-family: var(--font-display);
  font-size: clamp(22px, 3vw, 34px);
  font-weight: 600;
  text-align: center;
  color: var(--white);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 48px;
  position: relative;
}
.section-title::after {
  content: '';
  display: block;
  width: 60px;
  height: 3px;
  background: linear-gradient(90deg, var(--blue-accent), var(--gold));
  margin: 14px auto 0;
  border-radius: 2px;
}

/* PRODUCTS GRID */
.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  max-width: 1300px;
  margin: 0 auto;
}

/* PRODUCT CARD */
.product-card {
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  cursor: pointer;
}
.product-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--card-shadow);
  border-color: rgba(37,99,235,0.4);
}
.product-card:hover .add-cart-btn { opacity: 1; transform: translateY(0); }

.product-badge {
  position: absolute;
  top: 12px; left: 12px;
  z-index: 2;
  background: var(--blue-accent);
  color: var(--white);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  padding: 3px 8px;
  border-radius: 4px;
  text-transform: uppercase;
}
.product-badge.sale  { background: var(--red); }
.product-badge.hot   { background: var(--orange); }

.product-img-wrap {
  padding: 28px 20px 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 180px;
  background: linear-gradient(160deg, rgba(17,29,60,0.6), rgba(10,15,30,0.8));
}

/* Watch placeholder icons */
.watch-placeholder {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48px;
  border: 2px solid var(--border);
  transition: transform var(--transition);
  position: relative;
}
.product-card:hover .watch-placeholder { transform: scale(1.08) rotate(-3deg); }

.watch-placeholder.dark   { background: radial-gradient(circle, #1a2040, #0a0f1e); border-color: rgba(37,99,235,0.3); }
.watch-placeholder.gold   { background: radial-gradient(circle, #2a2010, #1a1508); border-color: rgba(200,168,75,0.4); }
.watch-placeholder.blue   { background: radial-gradient(circle, #0d2040, #061020); border-color: rgba(59,130,246,0.4); }
.watch-placeholder.silver { background: radial-gradient(circle, #1e2530, #111820); border-color: rgba(200,210,230,0.3); }

.product-info {
  padding: 12px 16px 8px;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.product-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--off-white);
  letter-spacing: 0.02em;
}

.stars { color: #f6c90e; font-size: 13px; letter-spacing: 1px; }

.product-prices { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

.price-current {
  font-size: 14px;
  font-weight: 700;
  color: var(--white);
}

.price-old {
  font-size: 12px;
  color: var(--muted);
  text-decoration: line-through;
}

.add-cart-btn {
  margin: 8px 16px 16px;
  padding: 9px;
  background: var(--blue-accent);
  color: var(--white);
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.03em;
  font-family: var(--font-body);
  transition: background var(--transition), opacity var(--transition), transform var(--transition);
  opacity: 0;
  transform: translateY(4px);
}
.add-cart-btn:hover { background: var(--blue-glow); }

/* =============================================
   MID BANNER
   ============================================= */
.mid-banner {
  background: linear-gradient(90deg, var(--navy-mid) 0%, #0e1c40 50%, var(--navy-mid) 100%);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 32px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.mid-banner::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 80% 100% at 50% 50%, rgba(37,99,235,0.08) 0%, transparent 70%);
}
.mid-banner-text {
  font-family: var(--font-display);
  font-size: clamp(16px, 2.5vw, 26px);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--off-white);
  position: relative;
}

/* =============================================
   FOOTER
   ============================================= */
.footer {
  background: var(--navy-mid);
  border-top: 1px solid var(--border);
  padding-top: 64px;
}

.footer-top {
  display: grid;
  grid-template-columns: 1.4fr 1.4fr 1fr 1fr 1.2fr;
  gap: 40px;
  max-width: 1300px;
  margin: 0 auto;
  padding: 0 60px 60px;
}

.footer-heading {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--white);
  margin-bottom: 20px;
}

.footer-sub {
  font-size: 14px;
  font-weight: 600;
  color: var(--off-white);
  margin-bottom: 8px;
}

.footer-desc {
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 16px;
  line-height: 1.7;
}

.footer-address {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.8;
}
.footer-address a { color: var(--muted); transition: color var(--transition); }
.footer-address a:hover { color: var(--blue-glow); }

.footer-links { display: flex; flex-direction: column; gap: 12px; }
.footer-links a {
  font-size: 13px;
  color: var(--muted);
  transition: color var(--transition);
}
.footer-links a:hover { color: var(--off-white); }

/* Subscribe form */
.subscribe-form {
  display: flex;
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  transition: border-color var(--transition);
}
.subscribe-form:focus-within { border-color: var(--blue-accent); }
.subscribe-form input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  padding: 10px 14px;
  font-size: 13px;
  font-family: var(--font-body);
  color: var(--off-white);
  min-width: 0;
}
.subscribe-form input::placeholder { color: var(--muted); }
.subscribe-form button {
  padding: 10px 14px;
  background: var(--blue-accent);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--transition);
}
.subscribe-form button:hover { background: var(--blue-glow); }

/* App badges */
.app-badges {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 20px;
}
.app-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px 14px;
  font-size: 13px;
  font-weight: 500;
  color: var(--off-white);
  transition: border-color var(--transition), color var(--transition);
}
.app-badge:hover { border-color: var(--blue-accent); color: var(--blue-glow); }

/* Social Links */
.social-links { display: flex; gap: 14px; }
.social-links a {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--navy-card);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  transition: background var(--transition), border-color var(--transition), color var(--transition);
}
.social-links a:hover {
  background: var(--blue-accent);
  border-color: var(--blue-accent);
  color: var(--white);
}

.footer-bottom {
  border-top: 1px solid var(--border);
  padding: 20px 60px;
  text-align: center;
}
.footer-bottom p {
  font-size: 13px;
  color: var(--muted);
}

/* =============================================
   CART TOAST
   ============================================= */
.cart-toast {
  position: fixed;
  bottom: 30px;
  right: 30px;
  background: var(--blue-accent);
  color: var(--white);
  padding: 12px 22px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  box-shadow: 0 8px 24px rgba(37,99,235,0.4);
  transform: translateY(80px);
  opacity: 0;
  transition: transform 0.4s ease, opacity 0.4s ease;
  z-index: 999;
  pointer-events: none;
}
.cart-toast.show { transform: translateY(0); opacity: 1; }

/* =============================================
   RESPONSIVE — TABLET (≤ 1024px)
   ============================================= */
@media (max-width: 1024px) {
  .navbar { padding: 0 24px; }
  .search-bar input { width: 160px; }

  .hero-slide { padding: 60px 40px; }

  .product-section { padding: 56px 32px; }
  .products-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }

  .footer-top {
    grid-template-columns: 1fr 1fr 1fr;
    padding: 0 32px 48px;
  }
  .footer-bottom { padding: 20px 32px; }
}

/* =============================================
   RESPONSIVE — MOBILE (≤ 768px)
   ============================================= */
@media (max-width: 768px) {
  .announcement-bar { font-size: 12px; padding: 7px 12px; }

  .navbar { padding: 0 16px; height: 56px; }
  .nav-links { display: none; }
  .nav-right { display: none; }
  .hamburger { display: flex; }

  .hero-slide {
    flex-direction: column-reverse;
    padding: 40px 24px 60px;
    text-align: center;
    gap: 24px;
  }
  .hero-content { max-width: 100%; }
  .hero-title { font-size: clamp(22px, 6vw, 36px); }
  .hero-arrow { display: none; }

  .product-section { padding: 48px 16px; }
  .products-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }

  .add-cart-btn { opacity: 1; transform: translateY(0); }

  .footer-top {
    grid-template-columns: 1fr 1fr;
    padding: 0 16px 40px;
    gap: 28px;
  }
  .footer-bottom { padding: 16px; }
  .mid-banner { padding: 24px 16px; }
}

/* =============================================
   RESPONSIVE — SMALL MOBILE (≤ 480px)
   ============================================= */
@media (max-width: 480px) {
  .products-grid { grid-template-columns: 1fr; gap: 16px; }

  .footer-top { grid-template-columns: 1fr; }

  .hero-slide { padding: 32px 16px 56px; }
}
  </style>
