        </div>
        <div class="hero-image">
          <div class="watch-orb">
            <div class="orb-ring"></div>
            <div class="orb-inner">⚙</div>
          </div>
        </div>
      </div>
      <div class="hero-slide">
        <div class="hero-content">
          <h1 class="hero-title">Precision<br />Engineered<br />Timepieces.</h1>
          <a href="#trending" class="btn-primary hero-cta">Explore</a>
        </div>
        <div class="hero-image">
          <div class="watch-orb style2">
            <div class="orb-ring"></div>
            <div class="orb-inner">⌚</div>
          </div>
        </div>
      </div>
      <div class="hero-slide">
        <div class="hero-content">
          <h1 class="hero-title">Luxury Meets<br />Legacy in Every<br />Tick.</h1>
          <a href="#explore" class="btn-primary hero-cta">Discover</a>
        </div>
        <div class="hero-image">
          <div class="watch-orb style3">
            <div class="orb-ring"></div>
            <div class="orb-inner">✦</div>
          </div>
        </div>
      </div>
    </div>
    <button class="hero-arrow right" id="heroNext" aria-label="Next">&#10095;</button>
    <div class="hero-dots" id="heroDots">
      <span class="dot active" data-index="0"></span>
      <span class="dot" data-index="1"></span>
      <span class="dot" data-index="2"></span>
    </div>
  </section>

  <%
function firstImage(product) {
  for (const v of (product.variants || [])) {
    if (v.images && v.images.length) return v.images[0];
  }
  return null;
}
function lowestVariant(product) {
  return (product.variants || []).reduce((best, v) =>
    (!best || v.price < best.price) ? v : best, null);
}
%>

<!-- NEW ARRIVALS -->
<section class="product-section" id="new-arrivals">
  <h2 class="section-title">New Arrivals</h2>
  <div class="products-grid">
    <% if (!newArrivals || newArrivals.length === 0) { %>
      <p class="no-products">No products available right now.</p>
    <% } %>
    <% (newArrivals || []).forEach(function(product) {
         const img = firstImage(product);
         const variant = lowestVariant(product);
         const isOutOfStock = product.totalStock === 0;
         const hasOffer = !isOutOfStock && variant && variant.offerValue > 0;
         const salePrice = hasOffer
           ? Math.round(variant.price * (1 - variant.offerValue / 100)) : null;
    %>
    <div class="product-card">
      <% if (isOutOfStock) { %>
        <div class="product-badge" style="background:var(--muted)">Out of Stock</div>
      <% } else if (hasOffer) { %>
        <div class="product-badge sale">Sale</div>
      <% } else { %>
        <div class="product-badge">New</div>
      <% } %>
      <a href="/shop/<%= product._id %>">
        <div class="product-img-wrap">
          <% if (img) { %>
            <img src="<%= img %>" alt="<%= product.name %>" loading="lazy" />
          <% } else { %>
            <div class="watch-placeholder dark">⌚</div>
          <% } %>
        </div>
      </a>
      <div class="product-info">
        <p class="product-name"><%= product.name %></p>
        <p class="product-brand"><%= product.brand %></p>
        <div class="product-prices">
          <% if (hasOffer) { %>
            <span class="price-current">₹<%= salePrice.toLocaleString("en-IN") %></span>
            <span class="price-old">₹<%= variant.price.toLocaleString("en-IN") %></span>
          <% } else if (variant) { %>
            <span class="price-current">₹<%= variant.price.toLocaleString("en-IN") %></span>
          <% } %>
        </div>
      </div>
      <% if (isOutOfStock) { %>
        <button class="add-cart-btn" disabled
          style="opacity:0.45;cursor:not-allowed;background:var(--muted);transform:translateY(0);opacity:1;">
          Out of Stock
        </button>
      <% } else { %>
        <button class="add-cart-btn" data-id="<%= product._id %>">Add to Cart</button>
      <% } %>
    </div>
    <% }); %>
  </div>
</section>

<!-- DIVIDER BANNER -->
<div class="mid-banner">
  <div class="mid-banner-text">Excellence in Every Second</div>
</div>

