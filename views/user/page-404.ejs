<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 — Not Found</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-black min-h-screen flex flex-col items-center justify-center px-4 font-sans">

  <!-- 404 Number -->
  <h1 class="text-[120px] sm:text-[180px] md:text-[220px] font-black leading-none tracking-tighter select-none">
    404
  </h1>

  <!-- Divider -->
  <div class="w-16 h-px bg-black my-6"></div>

  <!-- Message -->
  <h2 class="text-xl sm:text-2xl font-semibold tracking-wide mb-3">Page Not Found</h2>
  <p class="text-gray-500 text-sm sm:text-base text-center max-w-sm mb-10">
    The page you're looking for doesn't exist or has been moved.
  </p>

  <!-- Button -->
  <a href="/"
     class="border border-black px-8 py-3 text-sm font-medium tracking-widest uppercase hover:bg-black hover:text-white transition-colors duration-200">
    Go Home
  </a>

</body>
</html>