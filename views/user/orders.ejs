<%- include("../partials/user/header") %>

<style>
/* Reuse the same page/sidebar shell as profile.ejs */
.profile-page { min-height: 100vh; background: var(--navy); padding: 40px 60px; }
.profile-wrap { display: grid; grid-template-columns: 260px 1fr; gap: 24px; max-width: 1100px; margin: 0 auto; }

.p-sidebar { background: var(--navy-card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; height: fit-content; position: sticky; top: 80px; }
.p-sidebar-head { padding: 24px 20px; background: linear-gradient(135deg, #0e1c40, #111d3c); border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 14px; }
.p-avatar { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(37,99,235,0.4); flex-shrink: 0; }
.p-avatar-init { width: 52px; height: 52px; border-radius: 50%; background: var(--blue-accent); border: 2px solid rgba(37,99,235,0.4); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 18px; font-weight: 700; color: #fff; flex-shrink: 0; }
.p-sidebar-name { font-size: 15px; font-weight: 600; color: var(--white); font-family: var(--font-body); }
.p-sidebar-email { font-size: 11px; color: var(--muted); margin-top: 2px; word-break: break-all; }
.p-nav-item { display: flex; align-items: center; gap: 12px; padding: 13px 20px; font-size: 13px; font-weight: 500; color: var(--muted); text-decoration: none; border-bottom: 1px solid rgba(37,99,235,0.07); transition: background var(--transition), color var(--transition); font-family: var(--font-body); }
.p-nav-item:hover { background: var(--navy-hover); color: var(--off-white); }
.p-nav-item.active { background: var(--navy-hover); color: var(--white); border-left: 3px solid var(--blue-accent); }
.p-nav-item svg { width: 15px; height: 15px; flex-shrink: 0; }
.p-nav-item.logout { color: var(--red); border-bottom: none; }
.p-nav-item.logout:hover { background: rgba(229,62,62,0.07); }

.p-main { display: flex; flex-direction: column; gap: 24px; }
.p-card { background: var(--navy-card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
.p-card-head { padding: 18px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
.p-card-title { font-family: var(--font-display); font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--white); }
.p-card-body { padding: 24px; }

/* Order list specific */
.order-card { background: var(--navy-mid); border: 1px solid var(--border); border-radius: 8px; padding: 18px 20px; margin-bottom: 14px; display: flex; align-items: center; gap: 16px; }
.order-card:last-child { margin-bottom: 0; }
.order-card-img { width: 56px; height: 56px; border-radius: 8px; overflow: hidden; background: var(--navy-card); flex-shrink: 0; }
.order-card-img img { width: 100%; height: 100%; object-fit: contain; padding: 4px; }
.order-card-info { flex: 1; min-width: 0; }
.order-card-name { font-size: 14px; font-weight: 600; color: var(--off-white); }
.order-card-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
.order-card-meta { text-align: right; margin-right: 8px; }
.order-card-status { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
.order-card-status.pending, .order-card-status.processing { color: var(--blue-glow); }
.order-card-status.shipped { color: #facc15; }
.order-card-status.delivered { color: #4ade80; }
.order-card-status.cancelled, .order-card-status.returned { color: #ef4444; }
.order-card-date { font-size: 11px; color: var(--muted); margin-top: 4px; }
.btn-view-details { background: var(--blue-accent); color: #fff; border: none; border-radius: 6px; padding: 9px 16px; font-size: 12px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; white-space: nowrap; }

.orders-empty { text-align: center; padding: 60px 24px; }
.orders-empty p { font-size: 13px; color: var(--muted); margin-bottom: 16px; }

@media (max-width: 900px) {
  .profile-page { padding: 24px 16px; }
  .profile-wrap { grid-template-columns: 1fr; }
  .p-sidebar { position: static; }
  .order-card { flex-wrap: wrap; }
}
</style>

<div class="profile-page">
  <div class="profile-wrap">

    <!-- ===== SIDEBAR (same as profile.ejs) ===== -->
    <aside class="p-sidebar">
      <div class="p-sidebar-head">
        <% if (user.profileImage) { %>
          <img src="<%= user.profileImage %>?v=<%= Date.now() %>" class="p-avatar" />
        <% } else { %>
          <div class="p-avatar-init"><%= (user.firstname || 'U')[0].toUpperCase() %></div>
        <% } %>
        <div>
          <div class="p-sidebar-name"><%= user.firstname %> <%= user.lastname %></div>
          <div class="p-sidebar-email"><%= user.email %></div>
        </div>
      </div>
      <a href="/profile" class="p-nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        My Profile
      </a>
      <a href="/orders" class="p-nav-item active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        My Orders
      </a>
      <a href="/wishlist" class="p-nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        My Wishlist
      </a>
      <a href="/wallet" class="p-nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        My Wallet
      </a>
      <a href="/reset-password" class="p-nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Change Password
      </a>
      <a href="/logout" class="p-nav-item logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Log out
      </a>
    </aside>

    <!-- ===== MAIN ===== -->
    <main class="p-main">
      <div class="p-card">
        <div class="p-card-head">
          <span class="p-card-title">My Orders</span>
        </div>
        <div class="p-card-body">


         <form method="GET" action="/orders" style="margin-bottom:20px; display:flex; gap:8px;">
  <input type="text" name="search" value="<%= search %>" placeholder="Search by Order ID or product name..." 
         style="flex:1; padding:10px 14px; background:var(--navy-mid); border:1px solid var(--border); border-radius:6px; color:var(--off-white);" />
  <button type="submit" class="btn-view-details">Search</button>
  <% if (search && search.trim()) { %>
    <a href="/orders" class="btn-view-details" style="background:var(--navy-mid); border:1px solid var(--border);">Clear</a>
  <% } %>
</form>

          <% if (!orders || orders.length === 0) { %>
            <div class="orders-empty">
              <p>You haven't placed any orders yet.</p>
              <a href="/shop" class="btn-view-details">Start Shopping</a>
            </div>
          <% } else { %>

            <% orders.forEach(function(order) { %>
              <% const firstItem = order.orderedItems[0]; %>
              <div class="order-card">
                <div class="order-card-img">
                  <% if (firstItem && firstItem.product) { %>
                    <img src="<%= firstItem.product.variants[0].images[0] %>" alt="<%= firstItem.product.name %>" />
                  <% } %>
                </div>
                <div class="order-card-info">
                  <div class="order-card-name">
                    <%= firstItem && firstItem.product ? firstItem.product.name : 'Item unavailable' %>
                  </div>
                  <% if (order.orderedItems.length > 1) { %>
                    <div class="order-card-sub">+<%= order.orderedItems.length - 1 %> more item<%= order.orderedItems.length > 2 ? 's' : '' %></div>
                  <% } %>
                </div>
                <div class="order-card-meta">
                  <div class="order-card-status <%= order.status.toLowerCase().replace(' ', '-') %>"><%= order.status %></div>
                  <div class="order-card-date"><%= new Date(order.createdOn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                </div>
                <a href="/order-details/<%= order._id %>" class="btn-view-details">View Details</a>
              </div>
            <% }) %>

            <% if (totalpages > 1) { %>
              <div class="pagination" style="display:flex; gap:8px; justify-content:center; margin-top:24px;">
                <% for (let i = 1; i <= totalpages; i++) { %>
                 <a href="/orders?page=<%= i %>&search=<%= search %>"
                     class="<%= i === currentPage ? 'btn-view-details' : 'btn-ghost' %>"
                     style="padding:8px 14px; font-size:12px; border-radius:6px; text-decoration:none;">
                    <%= i %>
                  </a>
                <% } %>
              </div>
            <% } %>

          <% } %>

        </div>
      </div>
    </main>

  </div>
</div>

<%- include("../partials/user/footer") %>