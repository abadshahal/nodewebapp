<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard</title>

<!-- CHART JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

/* RESET */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Segoe UI', sans-serif;
}

body {
  background: #020b1c;
  color: #fff;
}

/* LAYOUT */
.layout {
  display: flex;
  min-height: 100vh;
}

/* SIDEBAR */
.sidebar {
  width: 250px;
  background: #071a33;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: 0.3s;
}

.sidebar.hide {
  transform: translateX(-100%);
  position: absolute;
  z-index: 999;
}

.logo {
  font-size: 22px;
  margin-bottom: 30px;
}

.menu {
  list-style: none;
}

.menu li {
  padding: 12px;
  margin-bottom: 10px;
  cursor: pointer;
  border-radius: 8px;
  transition: 0.3s;
}

.menu li:hover,
.menu .active {
  background: #0d2a4d;
}

.sidebar-bottom {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.btn,
.btn-outline {
  padding: 10px;
  border-radius: 6px;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  display: block;
}

.btn {
  background: white;
  color: black;
}

.btn-outline {
  border: 1px solid white;
  background: transparent;
  color: white;
}
.btn:hover{
  opacity: 0.85;
  transition: 0.3s;
}

/* MAIN */
.main {
  flex: 1;
  padding: 20px;
}

/* NAVBAR */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu-toggle {
  font-size: 22px;
  cursor: pointer;
  display: none;
}

.profile {
  display: flex;
  align-items: center;
  gap: 10px;
}

.profile img {
  border-radius: 50%;
}

/* STATS */
.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-top: 20px;
}

.card {
  background: #081f3a;
  padding: 20px;
  border-radius: 15px;
}

.green {
  color: #00ff99;
}

/* CHART */
.chart-box {
  margin-top: 30px;
  background: #081f3a;
  padding: 20px;
  border-radius: 15px;
}

.chart-header {
  display: flex;
  justify-content: space-between;
}

.chart-placeholder {
  height: 300px;
  margin-top: 20px;
}

/* TABLE */
.table-section {
  margin-top: 30px;
}

.table-wrapper {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 10px;
}

th, td {
  padding: 12px;
  text-align: left;
}

thead {
  background: #0d2a4d;
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  .stats {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {

  .menu-toggle {
    display: block;
  }

  .sidebar {
    position: absolute;
    height: 100%;
    left: 0;
    top: 0;
  }

  .stats {
    grid-template-columns: 1fr;
  }
}

</style>
</head>

<body>

<div class="layout">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <h2 class="logo">VELORIAN</h2>

    <ul class="menu">
      <li class="active">Dashboard</li>
      <li>Products</li>
      <li>Order List</li>
      <!-- <li>Customer</li> -->
        <li><a href="/customers">Customers</a></li>
      <li>Sales</li>
      <li>Category</li>
      <li>Coupons</li>
      <li>Return List</li>
    </ul>

    <div class="sidebar-bottom">
      <button class="btn-outline">Account</button>
   <a href="/logout" class="btn">Logout</a>
   
     </div>
  </aside>

  <!-- MAIN -->
  <main class="main">

    <!-- NAVBAR -->
    <div class="navbar">
      <span class="menu-toggle" onclick="toggleSidebar()">☰</span>

      <div class="profile">
        <img src="https://i.pravatar.cc/40">
        <div>
          <p><%= admin?.id ? "Admin" : "" %></p>
          <span style="font-size:12px;color:gray;">Admin</span>
        </div>
      </div>
    </div>

    <!-- STATS -->
    <div class="stats">
      <div class="card">
        <h4>Total Customers</h4>
       <h2><%= totalCustomers %></h2>
        <p class="green">+16% this month</p>
      </div>

      <div class="card">
        <h4>Total Orders</h4>
       <h2><%= totalOrders %></h2>
      </div>

      <div class="card">
        <h4>Total Sales</h4>
       <h2>₹<%= totalSales %></h2>
      </div>

      <div class="card">
        <h4>Pending</h4>
        <h2><%= pendingOrders %></h2>
      </div>
    </div>

    <!-- CHART -->
    <div class="chart-box">
      <div class="chart-header">
        <h3>Sales Details</h3>
      </div>
      <canvas id="myChart"></canvas>
    </div>

    <!-- TABLE -->
    <div class="table-section">
      <h3>Top Selling Products</h3>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Rank</th>
              <th>Product</th>
              <th>Category</th>
              <th>Units</th>
              <th>Revenue</th>
            </tr>
          </thead>

         <tbody>
  <% if (topProducts && topProducts.length > 0) { %>
    <% topProducts.forEach(product => { %>
      <tr>
        <td><%= product.rank %></td>
        <td><%= product.product %></td>
        <td>--</td>
        <td><%= product.units %></td>
        <td>₹<%= product.revenue %></td>
      </tr>
    <% }) %>
  <% } else { %>
    <tr>
      <td colspan="5" style="text-align:center;">No data available</td>
    </tr>
  <% } %>
</tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<script>

// SIDEBAR TOGGLE
function toggleSidebar() {
  document.getElementById("sidebar").classList.toggle("hide");
}

// CHART JS
const ctx = document.getElementById('myChart');

new Chart(ctx, {
  type: 'bar',
  data: {
    labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
    datasets: [{
      label: 'Sales',
      data: [12,19,10,25,22,18,24,14,28,30,35,40],
      borderWidth: 1
    }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: {
        labels: { color: "#fff" }
      }
    },
    scales: {
      x: {
        ticks: { color: "#fff" }
      },
      y: {
        ticks: { color: "#fff" }
      }
    }
  }
});

</script>

</body>
</html>