<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reset Password</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --navy:       #060d1a;
  --navy-mid:   #0b1527;
  --navy-card:  #0f1c35;
  --border:     #1e2d4a;
  --border-glow:#2a4a8a;
  --radius:     14px;
  --white:      #e8edf8;
  --muted:      #6b7fa3;
  --blue-glow:  #3b82f6;
  --blue-accent:#2563eb;
  --blue-deep:  #1a4fd8;
  --success:    #10b981;
  --error:      #ef4444;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Plus Jakarta Sans', sans-serif;
  background: var(--navy);
  color: var(--white);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  overflow: hidden;
  position: relative;
}

/* ── Background ambience ── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 50% at 20% 30%, rgba(37,99,235,0.08) 0%, transparent 70%),
    radial-gradient(ellipse 50% 40% at 80% 70%, rgba(16,185,129,0.05) 0%, transparent 70%);
  pointer-events: none;
}

/* ── Card ── */
.rp-card {
  background: var(--navy-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  width: 100%;
  max-width: 460px;
  overflow: hidden;
  position: relative;
  animation: slideUp 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* top edge glow */
.rp-card::before {
  content: '';
  position: absolute;
  top: 0; left: 10%; right: 10%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(59,130,246,0.5), transparent);
}

/* ── Header ── */
.rp-head {
  padding: 30px 32px 22px;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(135deg, #0d1b38, #0b1527);
  position: relative;
}

.rp-icon {
  width: 44px; height: 44px;
  background: rgba(37,99,235,0.12);
  border: 1px solid rgba(37,99,235,0.25);
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 14px;
}

.rp-head h1 {
  font-size: 19px;
  font-weight: 700;
  letter-spacing: 0.03em;
  margin-bottom: 5px;
}

.rp-head p {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.5;
}

/* ── Body ── */
.rp-body { padding: 28px 32px 32px; }

/* ── Field ── */
.rp-field {
  margin-bottom: 16px;
  position: relative;
}

.rp-field label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 8px;
}

.rp-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.rp-input-wrap input {
  width: 100%;
  padding: 12px 44px 12px 14px;
  background: var(--navy-mid);
  border: 1px solid var(--border);
  border-radius: 9px;
  color: var(--white);
  font-family: inherit;
  font-size: 14px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.rp-input-wrap input:focus {
  border-color: rgba(37,99,235,0.55);
  box-shadow: 0 0 0 3px rgba(37,99,235,0.10);
}

.rp-input-wrap input.valid   { border-color: rgba(16,185,129,0.45); }
.rp-input-wrap input.invalid { border-color: rgba(239,68,68,0.5); }

/* eye toggle */
.rp-eye {
  position: absolute; right: 12px;
  background: none; border: none; cursor: pointer;
  color: var(--muted); padding: 2px;
  display: flex; align-items: center;
  transition: color 0.2s;
}
.rp-eye:hover { color: var(--white); }

/* ── Strength bar ── */
.rp-strength {
  margin-top: 8px;
  display: none;
}

.rp-strength.visible { display: block; }

.rp-strength-bars {
  display: flex; gap: 4px; margin-bottom: 5px;
}

.rp-bar {
  flex: 1; height: 3px; border-radius: 3px;
  background: var(--border);
  transition: background 0.3s;
}

.rp-bar.weak   { background: #ef4444; }
.rp-bar.fair   { background: #f59e0b; }
.rp-bar.good   { background: #3b82f6; }
.rp-bar.strong { background: #10b981; }

.rp-strength-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--muted);
}

/* ── Match hint ── */
.rp-hint {
  font-size: 12px;
  margin-top: 6px;
  min-height: 16px;
  transition: color 0.2s;
}
.rp-hint.match   { color: var(--success); }
.rp-hint.nomatch { color: var(--error); }

/* ── Submit btn ── */
.rp-btn {
  width: 100%;
  margin-top: 8px;
  padding: 13px;
  background: var(--blue-accent);
  color: #fff;
  border: none;
  border-radius: 9px;
  font-family: inherit;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.05em;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: background 0.2s, transform 0.15s;
}

.rp-btn::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.08), transparent);
}

.rp-btn:hover:not(:disabled) { background: var(--blue-deep); transform: translateY(-1px); }
.rp-btn:active:not(:disabled) { transform: translateY(0); }
.rp-btn:disabled { opacity: 0.45; cursor: not-allowed; }

/* ── Back link ── */
.rp-back {
  display: flex; align-items: center; justify-content: center;
  gap: 5px; margin-top: 18px;
  font-size: 13px; color: var(--muted);
  text-decoration: none;
  transition: color 0.2s;
}
.rp-back:hover { color: var(--white); }

/* ── Rules ── */
.rp-rules {
  background: rgba(37,99,235,0.06);
  border: 1px solid rgba(37,99,235,0.15);
  border-radius: 8px;
  padding: 12px 14px;
  margin-bottom: 20px;
  font-size: 12px;
  color: var(--muted);
  line-height: 1.7;
}

.rp-rules li {
  list-style: none;
  display: flex; align-items: center; gap: 7px;
}

.rp-rules li::before {
  content: '–';
  color: rgba(59,130,246,0.5);
}

/* hidden email */
#rpEmail { display: none; }

@media(max-width:480px){
  .rp-head, .rp-body { padding-left: 20px; padding-right: 20px; }
}
</style>
</head>
<body>

<div class="rp-card">

  <div class="rp-head">
    <div class="rp-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>
    <h1>Create New Password</h1>
    <p>Choose a strong password for your account</p>
  </div>

  <div class="rp-body">

    <input type="hidden" id="rpEmail" value="<%= email %>" />

    <ul class="rp-rules">
      <li>Minimum 8 characters</li>
      <li>At least one uppercase letter</li>
      <li>At least one number</li>
    </ul>

    <!-- New password -->
    <div class="rp-field">
      <label for="rpNewPass">New Password</label>
      <div class="rp-input-wrap">
        <input type="password" id="rpNewPass" placeholder="Enter new password" autocomplete="new-password" />
        <button class="rp-eye" type="button" data-target="rpNewPass" aria-label="Toggle password">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
      <div class="rp-strength" id="rpStrength">
        <div class="rp-strength-bars">
          <div class="rp-bar" id="rpB1"></div>
          <div class="rp-bar" id="rpB2"></div>
          <div class="rp-bar" id="rpB3"></div>
          <div class="rp-bar" id="rpB4"></div>
        </div>
        <span class="rp-strength-label" id="rpStrengthLabel"></span>
      </div>
    </div>

    <!-- Confirm password -->
    <div class="rp-field">
      <label for="rpConfirmPass">Confirm Password</label>
      <div class="rp-input-wrap">
        <input type="password" id="rpConfirmPass" placeholder="Confirm new password" autocomplete="new-password" />
        <button class="rp-eye" type="button" data-target="rpConfirmPass" aria-label="Toggle password">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
      <div class="rp-hint" id="rpMatchHint"></div>
    </div>

    <button class="rp-btn" id="rpSubmitBtn" disabled>Reset Password</button>

    <a href="/forgot-password" class="rp-back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
      Back to forgot password
    </a>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
const newPassEl    = document.getElementById('rpNewPass');
const confirmEl    = document.getElementById('rpConfirmPass');
const submitBtn    = document.getElementById('rpSubmitBtn');
const matchHint    = document.getElementById('rpMatchHint');
const strengthBox  = document.getElementById('rpStrength');
const strengthLbl  = document.getElementById('rpStrengthLabel');
const bars         = [document.getElementById('rpB1'), document.getElementById('rpB2'), document.getElementById('rpB3'), document.getElementById('rpB4')];
const emailVal     = document.getElementById('rpEmail').value;

// ── Eye toggle ──
document.querySelectorAll('.rp-eye').forEach(btn => {
  btn.addEventListener('click', () => {
    const inp = document.getElementById(btn.dataset.target);
    inp.type = inp.type === 'password' ? 'text' : 'password';
  });
});

// ── Strength ──
function getStrength(pw) {
  let score = 0;
  if (pw.length >= 8)              score++;
  if (/[A-Z]/.test(pw))            score++;
  if (/[0-9]/.test(pw))            score++;
  if (/[^A-Za-z0-9]/.test(pw))     score++;
  return score;
}

const levelMap = [
  { label: '',        cls: '' },
  { label: 'Weak',    cls: 'weak' },
  { label: 'Fair',    cls: 'fair' },
  { label: 'Good',    cls: 'good' },
  { label: 'Strong',  cls: 'strong' }
];

newPassEl.addEventListener('input', () => {
  const pw = newPassEl.value;
  if (!pw) { strengthBox.classList.remove('visible'); return; }

  strengthBox.classList.add('visible');
  const score = getStrength(pw);
  const level = levelMap[score];

  bars.forEach((b, i) => {
    b.className = 'rp-bar';
    if (i < score) b.classList.add(level.cls);
  });

  strengthLbl.textContent = level.label;
  strengthLbl.style.color = { weak:'#ef4444', fair:'#f59e0b', good:'#3b82f6', strong:'#10b981' }[level.cls] || '';

  checkMatch();
  validate();
});

// ── Match check ──
function checkMatch() {
  const pw  = newPassEl.value;
  const cfm = confirmEl.value;
  if (!cfm) { matchHint.textContent = ''; matchHint.className = 'rp-hint'; return; }

  if (pw === cfm) {
    matchHint.textContent = '✓ Passwords match';
    matchHint.className = 'rp-hint match';
    confirmEl.className = 'valid';
  } else {
    matchHint.textContent = '✗ Passwords do not match';
    matchHint.className = 'rp-hint nomatch';
    confirmEl.className = 'invalid';
  }
}

confirmEl.addEventListener('input', () => { checkMatch(); validate(); });

// ── Validate ──
function validate() {
  const pw  = newPassEl.value;
  const cfm = confirmEl.value;
  submitBtn.disabled = !(pw.length >= 8 && pw === cfm);
}

// ── Submit ──
submitBtn.addEventListener('click', async () => {
  const newPassword = newPassEl.value;

  submitBtn.textContent = 'Resetting…';
  submitBtn.disabled = true;

  try {
    const res  = await fetch('/reset-password', {
      method : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body   : JSON.stringify({ email: emailVal, newPassword })
    });
    const data = await res.json();


   if (data.success) {
  document.querySelector('.rp-body').innerHTML = `
    <div style="text-align:center; padding: 20px 0 10px;">
      <div style="
        width: 64px; height: 64px;
        background: rgba(16,185,129,0.12);
        border: 1px solid rgba(16,185,129,0.3);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 20px;
      ">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>
      <h2 style="font-size:18px; font-weight:700; margin-bottom:10px; color:#e8edf8;">Password Updated!</h2>
      <p style="font-size:13px; color:#6b7fa3; line-height:1.6; margin-bottom:28px;">
        Your password has been successfully changed.<br>Redirecting you to your account…
      </p>
      <div style="
        width: 36px; height: 36px;
        border: 3px solid rgba(37,99,235,0.2);
        border-top-color: #2563eb;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto;
      "></div>
      <style>@keyframes spin { to { transform: rotate(360deg); } }</style>
    </div>
  `;

  // Small delay so user sees the success message, then redirect to home
  setTimeout(() => {
  window.location.replace('/home'); // ← replaces current history entry, back button won't return
}, 1500);

}
 else {
      Swal.fire({
        icon : 'error',
        title: 'Failed',
        text : data.message || 'Something went wrong.',
        background: '#0f1c35',
        color: '#e8edf8',
        confirmButtonColor: '#2563eb'
      });
      submitBtn.textContent = 'Reset Password';
      submitBtn.disabled = false;
    }
  } catch {
    Swal.fire({
      icon : 'error',
      title: 'Network Error',
      text : 'Could not reach server.',
      background: '#0f1c35',
      color: '#e8edf8',
      confirmButtonColor: '#2563eb'
    });
    submitBtn.textContent = 'Reset Password';
    submitBtn.disabled = false;
  }
});
</script>
</body>
</html>
